<html><head><title>XIM AI Setup</title><HTA:APPLICATION ID="XIMSetup" APPLICATIONNAME="XIM AI Setup" BORDER="thin" CAPTION="yes" SINGLEINSTANCE="yes" SYSMENU="yes" WINDOWSTATE="normal" SCROLL="no"/><style>
body{background:#0a0a0c;color:#eee;font:14px Segoe UI;margin:0}main{width:560px;margin:0 auto;padding:34px}h1{font-size:28px;margin:0 0 8px}.muted{color:#9a9aa2}button{background:#2563eb;color:white;border:0;border-radius:8px;padding:11px 18px;font-weight:600}button:disabled{opacity:.45}input{background:#151519;color:#eee;border:1px solid #333;border-radius:7px;padding:9px;width:430px}#bar{height:7px;background:#222;border-radius:5px;margin:20px 0}#fill{height:100%;width:0;background:#3b82f6;border-radius:5px}#status{margin-top:12px;min-height:42px}
</style></head><body><main><h1>XIM AI</h1><div class="muted">Local AI workspace installer</div><p>Choose where XIM should be installed. The setup program is a small downloader; the large runtime and model files are downloaded separately.</p>
<input id="dir" value="%LOCALAPPDATA%\XIM.Matrix"/><br><br><button id="go" onclick="install()">Install XIM</button><div id="bar"><div id="fill"></div></div><div id="status">Ready.</div></main>
<script>var shell=new ActiveXObject("WScript.Shell"), fso=new ActiveXObject("Scripting.FileSystemObject");
// runs PowerShell and returns its exit code. $ErrorActionPreference=Stop makes a failed step exit non-zero.
function ps(c){return shell.Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference=\'Stop\';'+c.replace(/"/g,'\\"')+'"',0,true)}
function set(s,p){status.innerText=s;fill.style.width=p+'%'}
function fail(s){set(s,0);go.disabled=false}
function install(){go.disabled=true;
 // expand %LOCALAPPDATA% here, PowerShell does not expand it
 var d=shell.ExpandEnvironmentStrings(dir.value).replace(/\\/g,'/');
 // an existing dist\ install (laptop layout) is updated in place, otherwise the chosen folder is used
 var app=fso.FileExists(d+'/dist/XimAdmin.exe')?d+'/dist':d;
 var exe=app+'/XimAdmin.exe', z=d+'/XIM-Payload.zip';
 var u='https://github.com/romeomalcgh/XIM-AI/releases/latest/download/XIM-Payload.zip';
 set('Preparing...',5);
 if(ps('New-Item -ItemType Directory -Force -Path "'+d+'" | Out-Null')!==0){fail('Could not create '+d+'.');return}
 set('Downloading XIM components...',15);
 // a running XIM locks its exe, so the move fails and nothing is overwritten.
 // the old exe is kept as XimAdmin.exe.prev and put back if the extraction fails.
 var step='[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12;$ProgressPreference="SilentlyContinue";'
  +'try{Invoke-WebRequest -Uri "'+u+'" -OutFile "'+z+'";if(Test-Path "'+exe+'"){Move-Item "'+exe+'" "'+exe+'.prev" -Force};'
  +'try{Expand-Archive -LiteralPath "'+z+'" -DestinationPath "'+app+'" -Force}catch{if((Test-Path "'+exe+'.prev") -and -not (Test-Path "'+exe+'")){Move-Item "'+exe+'.prev" "'+exe+'" -Force};throw}}'
  +'finally{Remove-Item "'+z+'" -Force -ErrorAction SilentlyContinue}';
 if(ps(step)!==0){fail('Install failed. If XIM is open, close it and try again.');return}
 set('Creating desktop shortcut...',92);
 var w=app.replace(/\//g,'\\');
 var lnk='$ws=New-Object -ComObject WScript.Shell;$sc=$ws.CreateShortcut((Join-Path ([Environment]::GetFolderPath("Desktop")) "XIM AI.lnk"));'
  +'$sc.TargetPath="'+w+'\\XimAdmin.exe";$sc.WorkingDirectory="'+w+'";$sc.IconLocation="'+w+'\\XIM-Matrix.ico";$sc.Save()';
 var linked=ps(lnk)===0;
 set(linked?'Installation complete.':'Installed, but the desktop shortcut failed. Start XIM from '+w+'\\XimAdmin.exe',100);
 shell.Run('"'+exe+'"',1,false);
 if(linked) window.close()
}
</script></body></html>
