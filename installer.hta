<html><head><title>XIM AI Setup</title><HTA:APPLICATION ID="XIMSetup" APPLICATIONNAME="XIM AI Setup" BORDER="thin" CAPTION="yes" SINGLEINSTANCE="yes" SYSMENU="yes" WINDOWSTATE="normal" SCROLL="no"/><style>
body{background:#0a0a0c;color:#eee;font:14px Segoe UI;margin:0}main{width:560px;margin:0 auto;padding:34px}h1{font-size:28px;margin:0 0 8px}.muted{color:#9a9aa2}button{background:#2563eb;color:white;border:0;border-radius:8px;padding:11px 18px;font-weight:600}button:disabled{opacity:.45}input{background:#151519;color:#eee;border:1px solid #333;border-radius:7px;padding:9px;width:430px}#bar{height:7px;background:#222;border-radius:5px;margin:20px 0}#fill{height:100%;width:0;background:#3b82f6;border-radius:5px}#status{margin-top:12px;min-height:42px}
</style></head><body><main><h1>XIM AI</h1><div class="muted">Local AI workspace installer</div><p>Choose where XIM should be installed. The setup program is a small downloader; the large runtime and model files are downloaded separately.</p>
<input id="dir" value="%LOCALAPPDATA%\XIM.Matrix"/><br><br><button id="go" onclick="install()">Install XIM</button><div id="bar"><div id="fill"></div></div><div id="status">Ready.</div></main>
<script>var shell=new ActiveXObject("WScript.Shell"), fso=new ActiveXObject("Scripting.FileSystemObject");
function ps(c){return shell.Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "'+c.replace(/"/g,'\\"')+'"',0,true)}
function set(s,p){status.innerText=s;fill.style.width=p+'%'}
function install(){go.disabled=true;var d=dir.value.replace(/\\/g,'/');set('Preparing...',5);ps('$d="'+d+'";New-Item -ItemType Directory -Force -Path $d | Out-Null;');set('Downloading XIM components...',15);
var u='https://github.com/romeomalcgh/XIM-AI/releases/latest/download/XIM-Payload.zip';var z=d+'/XIM-Payload.zip';var c='$ProgressPreference="SilentlyContinue";Invoke-WebRequest -Uri "'+u+'" -OutFile "'+z+'";Expand-Archive -LiteralPath "'+z+'" -DestinationPath "'+d+'" -Force;Remove-Item "'+z+'" -Force';
var r=ps(c);set('Creating shortcuts...',92);ps('$ws=New-Object -ComObject WScript.Shell;$sc=$ws.CreateShortcut($env:USERPROFILE+"\\Desktop\\XIM AI.lnk");$sc.TargetPath="'+d+'/XimAdmin.exe";$sc.WorkingDirectory="'+d+'";$sc.IconLocation="'+d+'/XIM-Matrix.ico";$sc.Save();');set('Installation complete.',100);shell.Run('"'+d+'/XimAdmin.exe"',1,false);window.close()}
</script></body></html>